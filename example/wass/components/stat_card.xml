<?xml version="1.0" encoding="UTF-8"?>
<!-- 统计卡片：内部再 include 两次 mini_row.xml，验证多级 include / stat card: includes mini_row.xml twice to verify nested includes -->
<component id="stat_card" class="card" layout="column" flex="1" height="100%" gap="4">
  <style>
    .card    { background: #0F2220F2; border-color: #245048; border-width: 1; radius: 6; padding: 6; }
    .section { color: #9FF0D8; font-size: 10; text-shadow: false; }
    .muted   { color: #7FA89C; font-size: 8; text-shadow: false; }
    .accent  { color: #7FE08A; font-size: 8; text-shadow: false; }
  </style>

  <label class="section" text="统计与进度" width="100%" height="12"/>

  <include src="mini_row.xml"/>
  <include src="mini_row.xml"/>

  <row width="100%" height="12" gap="4" alignItems="center">
    <label class="muted" text="总进度" flex="1" height="10"/>
    <label id="slider_value" class="accent" text="35 / 100" width="56" height="10" textAlign="right"/>
  </row>

  <progress id="bar_main" value="35" max="100" width="100%" height="8"/>
</component>
