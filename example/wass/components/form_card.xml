<?xml version="1.0" encoding="UTF-8"?>
<!-- 表单卡片：文本框、开关，演示 JS 按 id 绑定 onChange / form card: text field and toggle, showing JS binding onChange by id -->
<component id="form_card" class="card" layout="column" flex="1" height="100%" gap="4">
  <style>
    .card    { background: #171426F2; border-color: #3A2E55; border-width: 1; radius: 6; padding: 6; }
    .section { color: #D9C8FF; font-size: 10; text-shadow: false; }
    .muted   { color: #9B8FBF; font-size: 8; text-shadow: false; }
    .input   { background: #0E0B18F2; border-color: #3A2E55; border-width: 1; radius: 3; color: #F1EAFF; font-size: 9; }
  </style>

  <label class="section" text="表单控件" width="100%" height="12"/>

  <row width="100%" height="18" gap="4" alignItems="center">
    <label class="muted" text="昵称" width="30" height="12"/>
    <text-field id="input_name" class="input" value="Steve" flex="1" height="18"/>
  </row>

  <row width="100%" height="14" gap="4" alignItems="center">
    <label class="muted" text="回显" width="30" height="12"/>
    <label id="echo_name" class="muted" text="你好，Steve" flex="1" height="12"/>
  </row>

  <row width="100%" height="16" gap="4" alignItems="center">
    <switch id="switch_dark" value="true" width="28" height="14"/>
    <label class="muted" text="深色模式" flex="1" height="12"/>
  </row>

  <label id="form_hint" class="muted" text="输入或切换试试" width="100%" height="10"/>
</component>
