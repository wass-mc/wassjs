<?xml version="1.0" encoding="UTF-8"?>
<!-- 侧栏组件：自己定义 .card/.section/.muted，与 menus/main.xml 同名但颜色不同 / sidebar component with its own .card/.section/.muted classes: same names as menus/main.xml, different colors -->
<component id="sidebar" class="card" layout="column" width="150" height="100%" gap="5">
  <style>
    .card    { background: #101820F2; border-color: #22303D; border-width: 1; radius: 6; padding: 6; }
    .section { color: #9FE8FF; font-size: 10; text-shadow: false; }
    .muted   { color: #7E93A8; font-size: 8; text-shadow: false; }
    .nav     { background: #16222E; border-color: #24384A; border-width: 1; radius: 4; color: #CFE3F5; font-size: 9; text-shadow: false; }
    .nav-active { background: #1E4A63; border-color: #3C8FB4; border-width: 1; radius: 4; color: #FFFFFF; font-size: 9; text-shadow: false; }
  </style>

  <label class="section" text="导航" width="100%" height="12"/>
  <button id="nav_home" class="nav-active" text="首页" width="100%" height="18"/>
  <button id="nav_stats" class="nav" text="统计" width="100%" height="18"/>
  <button id="nav_settings" class="nav" text="设置" width="100%" height="18"/>

  <separator width="100%" height="1"/>

  <panel layout="column" width="100%" height="52" background="#0C141CF2" radius="4" padding="5" gap="4">
    <label class="muted" text="子分组" width="100%" height="10"/>
    <button id="sub_a" class="nav" text="子项 A" width="100%" height="14"/>
    <button id="sub_b" class="nav" text="子项 B" width="100%" height="14"/>
  </panel>

  <row width="100%" height="16" gap="4" alignItems="center">
    <label class="muted" text="通知" flex="1" height="12"/>
    <switch id="switch_notify" value="true" width="30" height="14"/>
  </row>

  <panel layout="column" width="100%" height="38" gap="4">
    <label class="muted" text="音量" width="100%" height="10"/>
    <slider id="slider_level" min="0" max="100" value="35" width="100%" height="10"/>
    <progress id="bar_side" value="35" max="100" width="100%" height="6"/>
  </panel>

  <label id="side_status" class="muted" text="侧栏就绪" width="100%" height="10"/>
</component>
