<?xml version="1.0" encoding="UTF-8"?>
<!--
  商店页：两个商品（钻石 / 铁锭）+ 数量滑条 + 立即购买 + 全屏绿色方块入口。
  颜色统一为红色主题；数据来自 wass/json/shop.json。
  Shop page: two products (diamond / iron ingot), a quantity slider, a Buy button and an entry to the fullscreen page.
  Red theme throughout; data comes from wass/json/shop.json.
-->
<menu id="main" title="钻石商店" width="880" height="640">
  <style>
    .panel       { background: #F25A1119; border-color: #FF5555; border-width: 1; radius: 8; }
    .card        { background: #33FF8888; border-color: #FF6B6B; border-width: 1; radius: 6; padding: 6; }
    .card-active { background: #66FF5555; border-color: #FFAAAA; border-width: 2; radius: 6; padding: 6; }
    .btn         { background: #FF8E1B1B; border-color: #FFFF5555; border-width: 1; radius: 4; text-color: #FFFFFF; font-size: 9; text-shadow: false; }
    .btn-accent  { background: #FFB71C1C; border-color: #FFFF8888; border-width: 1; radius: 4; text-color: #FFFFFF; font-size: 9; text-shadow: false; }
    .title       { text-color: #FFF2E6E6; font-size: 15; text-shadow: false; }
    .section     { text-color: #FFFFE7E0; font-size: 10; text-shadow: false; }
    .muted       { text-color: #FFFFEFE8; font-size: 9; text-shadow: false; }
    .accent      { text-color: #FFFFB3B3; font-size: 9; text-shadow: false; }
    .price       { text-color: #FFFFD166; font-size: 9; text-shadow: false; }
  </style>

  <panel class="panel" layout="column" width="100%" height="100%" padding="10" gap="8">
    <include src="components/shop_header.xml"/>

    <!-- 商品卡片：两张并排 / product cards side by side -->
    <row width="100%" height="112" gap="8">
      <panel id="card_diamond" class="card-active" layout="column" width="48%" height="100%" gap="4">
        <row width="100%" height="52" gap="8" alignItems="center">
          <display-panel id="item_diamond" item="minecraft:diamond" size="48"
                         orientation="east" angle="-12" tooltip="§b钻石"/>
          <column flex="1" gap="2">
            <label id="name_diamond" class="title" text="§b钻石" width="100%" height="16"/>
            <label id="price_diamond" class="price" text="§e120 §7金币 / 颗" width="100%" height="12"/>
            <label id="desc_diamond" class="muted" text="闪亮而坚硬" width="100%" height="11"/>
          </column>
        </row>
        <button id="pick_diamond" class="btn" text="选择钻石" width="100%" height="18"/>
      </panel>

      <panel id="card_iron" class="card" layout="column" width="48%" height="100%" gap="4">
        <row width="100%" height="52" gap="8" alignItems="center">
          <display-panel id="item_iron" item="minecraft:iron_ingot" size="48"
                         orientation="north" angle="8" tooltip="§f铁锭"/>
          <column flex="1" gap="2">
            <label id="name_iron" class="title" text="§f铁锭" width="100%" height="16"/>
            <label id="price_iron" class="price" text="§e35 §7金币 / 个" width="100%" height="12"/>
            <label id="desc_iron" class="muted" text="最常用的材料" width="100%" height="11"/>
          </column>
        </row>
        <button id="pick_iron" class="btn" text="选择铁锭" width="100%" height="18"/>
      </panel>
    </row>

    <!-- 选中商品 + 数量 + 总计 / selected product, quantity and total -->
    <panel class="card" layout="column" width="100%" height="86" gap="4">
      <label id="selected_label" class="section" text="§7当前商品：钻石 (minecraft:diamond)" width="100%" height="14"/>
      <row width="100%" height="16" gap="8" alignItems="center">
        <label id="qty_label" class="accent" text="购买数量：§e1" width="120" height="14"/>
        <slider id="qty_slider" width="100%" flex="1" height="14" min="1" max="64" value="1"/>
      </row>
      <label id="total_label" class="price" text="总计：§e120 §7金币" width="100%" height="14"/>
    </panel>

    <!-- XML Display Panel 展示：四个图标朝向各不相同 / display panels: four icons with different orientations -->
    <panel class="card" layout="column" width="100%" height="86" gap="4">
      <label class="section" text="Display Panel（XML 定义，图标可旋转）" width="100%" height="13"/>
      <row width="100%" height="56" gap="8" alignItems="center">
        <display-panel id="xml_item_a" item="minecraft:diamond" size="46" orientation="east" angle="-12" tooltip="§b钻石 · east / -12°"/>
        <display-panel id="xml_item_b" item="minecraft:iron_ingot" size="46" orientation="north" angle="8" count="3" tooltip="§f铁锭 · north / 8°"/>
        <display-panel id="xml_item_c" item="minecraft:emerald" size="46" orientation="southwest" tooltip="§a绿宝石 · southwest"/>
        <display-panel id="xml_item_d" item="minecraft:redstone" size="46" orientation="northeast" angle="-20" tooltip="§c红石 · northeast / -20°"/>
        <column flex="1" gap="2">
          <label class="muted" text="§8orientation / angle 完全由 XML 指定" width="100%" height="11"/>
          <label class="muted" text="§8图标是物品的 2D 图标，支持模组物品" width="100%" height="11"/>
          <label class="muted" text="§8← 四个图标朝向各不相同" width="100%" height="11"/>
        </column>
      </row>
    </panel>

    <!-- 其它控件回归测试 / other controls, kept for regression testing -->
    <panel class="card" layout="column" width="100%" flex="1" gap="4">
      <label class="section" text="其它控件（回归测试）" width="100%" height="13"/>
      <row width="100%" height="22" gap="10" alignItems="center">
        <column flex="1" gap="2">
          <label class="muted" text="§8文本输入" width="100%" height="11"/>
          <text-field id="input_name" width="100%" height="18" value="输入昵称…"/>
        </column>
        <column width="90" gap="2">
          <label class="muted" text="§8开关" width="100%" height="11"/>
          <switch id="switch_sound" width="36" height="14" value="true"/>
        </column>
        <column width="140" gap="2">
          <label class="muted" text="§8库存进度" width="100%" height="11"/>
          <progress id="stock_bar" width="100%" height="10" value="1" max="64"/>
        </column>
        <column flex="1" gap="2">
          <label id="echo_label" class="muted" text="§7回显：" width="100%" height="11"/>
          <label id="switch_label" class="accent" text="§a音效：开" width="100%" height="11"/>
        </column>
      </row>
      <row width="100%" flex="1" height="112" gap="8" alignItems="center">
        <image id="shot" src="tex/screenshot.png" width="200" height="108" border="0"/>
        <column flex="1" gap="2">
          <label class="muted" text="§8图片来源：wass/tex/screenshot.png" width="100%" height="11"/>
          <label class="muted" text="§8PNG 放在服务器 wass/tex/ 下即可" width="100%" height="11"/>
          <label class="muted" text="§8支持整图拉伸 / 九宫格（border 属性）" width="100%" height="11"/>
        </column>
      </row>
    </panel>

    <label id="shop_status" class="muted" text="§7选择商品后调整数量，再点“立即购买”。" width="100%" height="14"/>

    <include src="components/shop_footer.xml"/>
  </panel>
</menu>
