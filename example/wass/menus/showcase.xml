<?xml version="1.0" encoding="UTF-8"?>
<!--
  全屏菜单：整屏暗红背景 + 居中的旋转绿色方块。
  fullscreen="true" 让窗口铺满屏幕；JS 在 onOpen 里启动旋转与渐入。
  Fullscreen menu: dark red backdrop with a rotating green square in the center.
  fullscreen="true" fills the screen; JS starts the rotation and fade-in in onOpen.
-->
<menu id="showcase" title="旋转的绿色方块" width="900" height="600" fullscreen="true">
  <style>
    .title { text-color: #FF7CFFB2; font-size: 16; text-shadow: false; }
    .muted { text-color: #FFD9E6E0; font-size: 9; text-shadow: false; }
    .btn   { background: #FF8E1B1B; border-color: #FFFF5555; border-width: 1; radius: 4; text-color: #FFFFFF; font-size: 9; text-shadow: false; }
  </style>

  <panel id="backdrop" layout="column" width="100%" height="100%"
         background="#E6140505" alignItems="center" justifyContent="center" gap="10">
    <panel id="square" width="120" height="120" background="#FF2ECC71" radius="10" tooltip="§a旋转的绿色方块"/>
    <label id="showcase_title" class="title" text="§a旋转的绿色方块" width="100%" height="20" textAlign="center"/>
    <label id="showcase_hint" class="muted" text="§7整屏背景 + 会旋转的方块，全部由 XML + JS 构建"
           width="100%" height="13" textAlign="center"/>
    <button id="btn_back" class="btn" text="§c关闭（渐出）" width="140" height="20"/>
  </panel>
</menu>
